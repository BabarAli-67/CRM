PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/flash-digital-crm
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Super Admin (env-provisioned only — never public register)
ADMIN_NAME=Super Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flashdigital.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Admin (Auditor) — env-provisioned only (never public register)
AUDITOR_NAME=Admin Auditor
AUDITOR_USERNAME=auditor
# Optional: if AUDITOR_USERNAME is empty, local-part of email is used as username
AUDITOR_EMAIL=auditor@flashdigital.com
AUDITOR_PASSWORD=replace_with_a_strong_auditor_password

# Tech Head — env-provisioned only (never public register)
# Tech specialists are created only from Tech Head → Team Management
TECH_HEAD_NAME=Tech Head
TECH_HEAD_USERNAME=techhead
# Optional: if TECH_HEAD_USERNAME is empty, local-part of email is used as username
TECH_HEAD_EMAIL=techhead@flashdigital.com
TECH_HEAD_PASSWORD=replace_with_a_strong_tech_head_password

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
